#!name=AppStore走代理其他Apple请求走直连
#!desc=AppStore下载走代理,默认PROXY,其它Apple请求走DIRECT
#!icon=https://developer.apple.com/assets/elements/icons/app-store/app-store-128x128_2x.png

[Rule]
DOMAIN-SUFFIX,apps.apple.com,PROXY
DOMAIN-SUFFIX,itunes.apple.com,PROXY
DOMAIN-SUFFIX,iosapps.itunes.apple.com,PROXY
DOMAIN-SUFFIX,buy.itunes.apple.com,PROXY
DOMAIN-SUFFIX,mzstatic.com,PROXY
DOMAIN-SUFFIX,amp-api-updates.apps.apple.com,PROXY
DOMAIN-SUFFIX,app-store.apple.com,PROXY
DOMAIN-SUFFIX,apple.com,DIRECT
DOMAIN-SUFFIX,cdn-apple.com,DIRECT
DOMAIN-SUFFIX,aaplimg.com,DIRECT
DOMAIN-SUFFIX,icloud.com,DIRECT
DOMAIN-SUFFIX,icloud-content.com,DIRECT
DOMAIN-SUFFIX,icloud.com.cn,DIRECT
DOMAIN-SUFFIX,me.com,DIRECT
DOMAIN-SUFFIX,applepay.com,DIRECT
DOMAIN-SUFFIX,applepodcasts.com,DIRECT
DOMAIN-SUFFIX,appletv.com,DIRECT
DOMAIN-SUFFIX,iwork.com,DIRECT
DOMAIN-SUFFIX,beatsbydre.com,DIRECT
