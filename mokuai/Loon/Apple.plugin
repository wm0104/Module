DOMAIN-SUFFIX,itunes.apple.com,PROXY
DOMAIN-SUFFIX,iosapps.itunes.apple.com,PROXY
DOMAIN-SUFFIX,play.itunes.apple.com,PROXY

DOMAIN-SUFFIX,mzstatic.com,PROXY
DOMAIN-SUFFIX,phobos.apple.com,PROXY
DOMAIN-SUFFIX,download.itunes.apple.com,PROXY

DOMAIN-SUFFIX,g.aaplimg.com,PROXY
DOMAIN-SUFFIX,v.aaplimg.com,PROXY


# =====================
# Apple其它服务（DIRECT）
# =====================

DOMAIN-SUFFIX,icloud.com,DIRECT
DOMAIN-SUFFIX,icloud-content.com,DIRECT
DOMAIN-SUFFIX,icloudmailattachment.com,DIRECT
DOMAIN-SUFFIX,icloud.com.cn,DIRECT

DOMAIN-SUFFIX,me.com,DIRECT
DOMAIN-SUFFIX,mac.com,DIRECT

DOMAIN-SUFFIX,push.apple.com,DIRECT

DOMAIN-SUFFIX,captive.apple.com,DIRECT

DOMAIN-SUFFIX,apple-mapkit.com,DIRECT
DOMAIN-SUFFIX,apple-cloudkit.com,DIRECT


# Apple主域兜底
DOMAIN-SUFFIX,apple.com,DIRECT